# Copy to .env and adjust as needed.

# Postgres credentials (used by the db, api services)
POSTGRES_USER=debt
POSTGRES_PASSWORD=debt
POSTGRES_DB=debt_tracker

# CORS — "*" for local use, or a comma-separated list of origins
CORS_ORIGINS=*

# Host ports. Change these if 8000 / 3000 are already in use on your machine.
# (The web app reaches the API over Docker's internal network, so changing
#  API_PORT only affects direct host access to the API — not the app.)
API_PORT=8000
WEB_PORT=3000
